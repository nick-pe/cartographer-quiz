# Cache rules for Cloudflare (Workers static assets).
# Built JS, CSS and fonts have a content hash in their name: keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Flags, icons and preview images change rarely.
/flags/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
